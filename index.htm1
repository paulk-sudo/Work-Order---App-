<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Bridgetown Work Order</title>
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#111111">
  <style>
    :root { --border:#222; --light:#f7f7f7; }
    body { font-family: Arial, sans-serif; margin: 0; background:#e9ecef; }
    .page { max-width: 980px; margin: 18px auto; background:#fff; padding: 18px; border: 1px solid #ccc; }
    .topbar { display:flex; align-items:center; justify-content:space-between; gap:12px; }
    .brand { font-weight:700; letter-spacing:.5px; display:flex; align-items:center; gap:10px; }
    .brand .logo { width: 34px; height: 34px; border: 2px solid var(--border); border-radius: 6px; display:inline-flex; align-items:center; justify-content:center; font-weight:800; }
    .title { font-weight:800; font-size: 20px; }
    .grid { display:grid; gap:10px; margin-top: 12px; }
    .row { display:grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .row3 { display:grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; }
    .field { border: 1px solid var(--border); }
    .field label { display:block; font-size: 12px; padding: 6px 8px; background: var(--light); border-bottom:1px solid var(--border); }
    .field input, .field textarea { width:100%; border:0; padding:10px 8px; font-size:14px; outline:none; box-sizing:border-box; }
    textarea { min-height: 72px; resize: vertical; }
    h3.section { margin: 14px 0 8px; font-size: 13px; text-transform: uppercase; letter-spacing: .6px; }
    table { width:100%; border-collapse: collapse; }
    th, td { border: 1px solid var(--border); padding: 8px; font-size: 14px; vertical-align: middle; }
    th { background: var(--light); text-align:left; font-size: 12px; }
    td input { width: 100%; border: 0; outline: none; font-size: 14px; }
    .qty { width: 70px; }
    .cat { width: 140px; }
    .actions { display:flex; gap:10px; flex-wrap: wrap; margin-top: 12px; }
    button { padding: 10px 12px; border:1px solid var(--border); background:#fff; cursor:pointer; font-weight:600; border-radius:8px; }
    button.primary { background:#111; color:#fff; }
    .hint { font-size: 12px; color:#444; margin-top: 6px; }
    .tapScan { background: #fff7d1; }
    .modal {
      position: fixed; inset: 0; background: rgba(0,0,0,.6);
      display:none; align-items:center; justify-content:center; padding: 12px;
    }
    .modal .box { background:#fff; width:min(720px, 98vw); border-radius: 12px; overflow:hidden; }
    .modal header { display:flex; justify-content:space-between; align-items:center; padding: 10px 12px; border-bottom:1px solid #ddd; }
    #videoWrap { position: relative; background:#000; }
    video { width:100%; height:auto; display:block; }
    .small { font-size: 12px; color:#555; }
    .footer { display:flex; justify-content:space-between; gap: 10px; margin-top: 12px; }
  </style>
</head>
<body>
  <div class="page">
    <div class="topbar">
      <div class="brand">
        <div class="logo">B</div>
        <div>BRIDGETOWN INDUSTRIES</div>
      </div>
      <div class="title">WORK ORDER</div>
    </div>

    <div class="grid">
      <div class="row">
        <div class="field">
          <label>Customer</label>
          <input id="customer" placeholder="Customer name" />
        </div>
        <div class="field">
          <label>Date</label>
          <input id="date" type="date" />
        </div>
      </div>

      <div class="row3">
        <div class="field">
          <label>Year, Make, Model</label>
          <input id="ymm" placeholder="e.g., 2020 Ford F-150" />
        </div>
        <div class="field">
          <label>Unit No.</label>
          <input id="unitNo" placeholder="Unit #" />
        </div>
        <div class="field">
          <label>PO</label>
          <input id="po" placeholder="PO #" />
        </div>
      </div>

      <div class="row3">
        <div class="field">
          <label>VIN</label>
          <input id="vin" placeholder="VIN" />
        </div>
        <div class="field">
          <label>Mechanic</label>
          <input id="mechanic" placeholder="Mechanic name" />
        </div>
        <div class="field">
          <label>Mileage</label>
          <input id="mileage" placeholder="Mileage" inputmode="numeric" />
        </div>
      </div>
    </div>

    <h3 class="section">Parts</h3>
    <div class="hint">Tip: tap a <b>Part No.</b> cell (yellow) to scan a barcode into it.</div>

    <table id="partsTable">
      <thead>
        <tr>
          <th class="qty">QTY</th>
          <th>PART NO. &amp; DESCRIPTION</th>
          <th class="cat">CATEGORY</th>
          <th class="qty">QTY</th>
          <th>PART NO. &amp; DESCRIPTION</th>
          <th class="cat">CATEGORY</th>
        </tr>
      </thead>
      <tbody id="partsBody"></tbody>
    </table>

    <div class="actions">
      <button id="addRow" class="primary">+ Add Parts Row</button>
      <button id="save">Save</button>
      <button id="load">Load</button>
      <button id="clear">Clear</button>
    </div>

    <h3 class="section">Description of Work</h3>
    <div class="field">
      <label>Work Performed</label>
      <textarea id="workDesc" placeholder="A) ...&#10;B) ..."></textarea>
    </div>

    <div class="footer">
      <div class="field" style="flex:1;">
        <label>Notes</label>
        <textarea id="notes" placeholder="Notes..."></textarea>
      </div>
      <div class="field" style="width:220px;">
        <label>Total</label>
        <input id="total" placeholder="$0.00" />
      </div>
    </div>
  </div>

  <!-- Scanner Modal -->
  <div class="modal" id="scannerModal" aria-hidden="true">
    <div class="box">
      <header>
        <div>
          <div style="font-weight:800;">Scan Barcode</div>
          <div class="small">Point the camera at the barcode. It will fill the selected cell.</div>
        </div>
        <button id="closeScanner">Close</button>
      </header>
      <div id="videoWrap">
        <video id="video" autoplay playsinline></video>
      </div>
    </div>
  </div>

  <script src="scanner.js"></script>
  <script>
    // Build initial rows
    const partsBody = document.getElementById('partsBody');

    function makeCellInput({placeholder="", className="", onFocus=null}) {
      const td = document.createElement('td');
      const input = document.createElement('input');
      input.placeholder = placeholder;
      if (className) input.className = className;
      if (onFocus) input.addEventListener('focus', onFocus);
      td.appendChild(input);
      return { td, input };
    }

    function addPartsRow() {
      const tr = document.createElement('tr');

      // Left set
      const qty1 = makeCellInput({placeholder:"", className:"qty"});
      const part1 = makeCellInput({
        placeholder:"Tap to scan part # / type description",
        className:"tapScan",
        onFocus: () => window.Scanner.openForInput(part1.input)
      });
      const cat1 = makeCellInput({placeholder:"Category", className:"cat"});

      // Right set
      const qty2 = makeCellInput({placeholder:"", className:"qty"});
      const part2 = makeCellInput({
        placeholder:"Tap to scan part # / type description",
        className:"tapScan",
        onFocus: () => window.Scanner.openForInput(part2.input)
      });
      const cat2 = makeCellInput({placeholder:"Category", className:"cat"});

      [qty1.td, part1.td, cat1.td, qty2.td, part2.td, cat2.td].forEach(td => tr.appendChild(td));
      partsBody.appendChild(tr);
    }

    // Add 5 rows by default
    for (let i=0; i<5; i++) addPartsRow();

    document.getElementById('addRow').addEventListener('click', addPartsRow);

    // Save/Load
    function snapshot() {
      const rows = [...partsBody.querySelectorAll('tr')].map(tr => {
        const inputs = [...tr.querySelectorAll('input')].map(i => i.value);
        return inputs;
      });
      return {
        customer: customer.value,
        date: date.value,
        ymm: ymm.value,
        unitNo: unitNo.value,
        po: po.value,
        vin: vin.value,
        mechanic: mechanic.value,
        mileage: mileage.value,
        total: total.value,
        workDesc: workDesc.value,
        notes: notes.value,
        partsRows: rows
      };
    }

    function restore(data) {
      customer.value = data.customer || "";
      date.value = data.date || "";
      ymm.value = data.ymm || "";
      unitNo.value = data.unitNo || "";
      po.value = data.po || "";
      vin.value = data.vin || "";
      mechanic.value = data.mechanic || "";
      mileage.value = data.mileage || "";
      total.value = data.total || "";
      workDesc.value = data.workDesc || "";
      notes.value = data.notes || "";

      partsBody.innerHTML = "";
      (data.partsRows || []).forEach(r => {
        addPartsRow();
        const tr = partsBody.lastElementChild;
        const inputs = tr.querySelectorAll('input');
        r.forEach((val, idx) => { if (inputs[idx]) inputs[idx].value = val; });
      });
      if ((data.partsRows || []).length === 0) for (let i=0; i<5; i++) addPartsRow();
    }

    document.getElementById('save').addEventListener('click', () => {
      localStorage.setItem('workOrderDraft', JSON.stringify(snapshot()));
      alert('Saved on this device.');
    });

    document.getElementById('load').addEventListener('click', () => {
      const raw = localStorage.getItem('workOrderDraft');
      if (!raw) return alert('Nothing saved yet.');
      restore(JSON.parse(raw));
      alert('Loaded.');
    });

    document.getElementById('clear').addEventListener('click', () => {
      if (!confirm('Clear the form?')) return;
      restore({});
    });

    // Default date today
    const d = new Date();
    document.getElementById('date').value = d.toISOString().slice(0,10);

    // Register service worker
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('./sw.js').catch(()=>{});
    }
  </script>
</body>
</html>
